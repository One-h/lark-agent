{
  "name": "lark-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/One-h/lark-agent.git" },
  "bugs": { "url": "https://github.com/One-h/lark-agent/issues" },
  "homepage": "https://github.com/One-h/lark-agent#readme",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "build": "tsc --noEmit",
    "test": "LARK_AGENT_TEST_DATABASE=1 tsx --test --test-concurrency=4 \"**/*.test.ts\"",
    "test:app-server": "tsx scripts/verify-app-server-dynamic-tools.ts",
    "test:sticker-tools": "tsx scripts/verify-sticker-tools.ts",
    "test:sticker-mcp-resume": "tsx scripts/verify-sticker-mcp-resume.ts",
    "test:rapid-session-reuse": "tsx scripts/verify-rapid-session-reuse.ts",
    "import:forge-history": "tsx scripts/import-forge-history.ts",
    "serve": "tsx apps/runtime/src/index.ts"
  },
  "workspaces": ["apps/*", "packages/*"],
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "csv-parse": "^7.0.2",
    "fastify": "^5.3.2",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.19",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
